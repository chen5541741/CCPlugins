# 必填：KOOK Bot Token，开发者后台 → Bot → "机器人连接模式" 获取
KOOK_BOT_TOKEN=

# 推送默认目标（省去每次敲 --type / --target）
KOOK_TARGET_TYPE=channel        # channel 或 dm
KOOK_TARGET_ID=                 # channel_id 或 user_id

# Claude Code hook（可选）
KOOK_NOTIFY=1                   # 0 = 关闭所有 hook 推送；其他/未设 = 开
KOOK_NOTIFY_THRESHOLD=60        # Stop hook 触发的最小耗时（秒），默认 60

# 自定义设备/账号识别前缀，会拼到消息最前面，例如：
#   KOOK_NOTIFY_DIY=iMac-Pro
#   → [iMac-Pro][kook-sh] Claude Code 完成 · 1m23s
# 留空或注释掉则消息里不出现该前缀。
KOOK_NOTIFY_DIY=
